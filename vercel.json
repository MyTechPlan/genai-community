{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/join",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es"
        }
      ],
      "destination": "https://id.genaicommunity.eu/es/join",
      "statusCode": 302
    },
    {
      "source": "/join",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr"
        }
      ],
      "destination": "https://id.genaicommunity.eu/fr/join",
      "statusCode": 302
    },
    {
      "source": "/join",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^pt"
        }
      ],
      "destination": "https://id.genaicommunity.eu/pt/join",
      "statusCode": 302
    },
    {
      "source": "/join",
      "destination": "https://id.genaicommunity.eu/en/join",
      "statusCode": 302
    },
    {
      "source": "/join/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es"
        }
      ],
      "destination": "https://id.genaicommunity.eu/es/join",
      "statusCode": 302
    },
    {
      "source": "/join/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr"
        }
      ],
      "destination": "https://id.genaicommunity.eu/fr/join",
      "statusCode": 302
    },
    {
      "source": "/join/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^pt"
        }
      ],
      "destination": "https://id.genaicommunity.eu/pt/join",
      "statusCode": 302
    },
    {
      "source": "/join/",
      "destination": "https://id.genaicommunity.eu/en/join",
      "statusCode": 302
    },
    {
      "source": "/rgpd",
      "destination": "/privacy",
      "statusCode": 301
    },
    {
      "source": "/rgpd/",
      "destination": "/privacy",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1"
        }
      ]
    }
  ]
}
