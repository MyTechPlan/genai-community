---
import Base from '../layouts/Base.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import { Image } from 'astro:assets';
import { chapters } from '../data/chapters.js';
import '../styles/home.css';
import imgWorkshopFestTables from '../assets/home/workshop-fest-tables.jpg';
import imgWorkshopFestRoom from '../assets/home/workshop-fest-room.jpg';
import imgLisbonAudience from '../assets/home/lisbon-audience.jpg';
import imgLisbonPizza from '../assets/home/lisbon-pizza.jpg';
import imgLisbonSpeaker from '../assets/home/lisbon-speaker.jpg';
import imgLisbonTalk from '../assets/home/lisbon-talk.jpg';
import imgLisbonTeam from '../assets/home/lisbon-team.jpg';
import imgSummit2027Poster from '../assets/home/summit-2027-poster.jpg';
import imgValenciaDinner from '../assets/home/valencia-dinner.jpg';
import imgValenciaGroup from '../assets/home/valencia-group.jpg';

const madrid = chapters.find((chapter) => chapter.slug === 'madrid');
const madridIsForming = !madrid || madrid.status === 'Forming';

// Keep the map's existing placement and animation order.
const mapCities = [
  { slug: 'london', pos: 'r' },
  { slug: 'madrid', pos: 't' },
  { slug: 'valencia', pos: 'r' },
  { slug: 'lisbon', pos: 'b' },
].map((city) => ({ ...city, chapter: chapters.find((chapter) => chapter.slug === city.slug) }));

// Editorial order: event photos and slots resolved from the shared chapter leads.
const ribbonRowOne = [
  { src: imgLisbonTalk, wide: true, alt: 'A speaker presenting next to a screen, seen from behind the audience', caption: 'Lisbon meetup' },
  { lead: 'valencia:0' },
  { src: imgWorkshopFestRoom, wide: true, alt: 'People listening at a workshop, laptops on shared tables', caption: 'GenAI Workshop Fest' },
  { src: imgValenciaGroup, wide: true, alt: 'A group of people standing on a stage in front of the slide for a Valencia meetup on AI governance', position: '50% 45%', caption: 'Valencia meetup' },
  { lead: 'london:1' },
  { src: imgLisbonPizza, alt: 'People opening pizza boxes on a long table after the talks', caption: 'Lisbon meetup' },
  { lead: 'lisbon:0' },
];
const ribbonRowTwo = [
  { lead: 'london:0' },
  { src: imgLisbonAudience, wide: true, alt: 'People seated in rows listening to a talk', caption: 'Lisbon meetup' },
  { src: imgWorkshopFestTables, wide: true, alt: 'People working on laptops at shared tables', caption: 'GenAI Workshop Fest' },
  { lead: 'lisbon:1' },
  { src: imgLisbonTeam, wide: true, alt: 'Four people standing together next to the GenAI Community banner', position: '50% 30%', caption: 'Lisbon meetup' },
  { lead: 'valencia:1' },
  { src: imgValenciaDinner, alt: 'People around a long table raising their drinks, a GenAI cap on the table', position: '50% 40%', caption: 'Valencia' },
];
const ribbonSlots = new Set([ ...ribbonRowOne, ...ribbonRowTwo ]
  .filter((tile) => 'lead' in tile).map((tile) => tile.lead));
const ribbonRows = [ribbonRowOne, ribbonRowTwo].map((row) => row.map((tile) => {
  if (!('lead' in tile)) return tile;
  const [slug, index] = tile.lead.split(':');
  const chapter = chapters.find((chapter) => chapter.slug === slug);
  const lead = chapter?.leads[Number(index)];
  return lead ? { lead, city: chapter.city } : null;
}).filter(Boolean));
// Leads without an editorial slot follow at the end of row two, in chapter order.
ribbonRows[1].push(...chapters.flatMap((chapter) => chapter.leads
  .filter((_, index) => !ribbonSlots.has(`${chapter.slug}:${index}`))
  .map((lead) => ({ lead, city: chapter.city }))));
---
<Base title="GenAI Community EU — Where Europe's GenAI builders meet">
  <div class="hm">
<section class="hero intro" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <p class="eyebrow fade" style="--i:0">Valencia · Lisbon · London · Madrid</p>
        <h1 class="h1"><span class="ln" style="--i:0"><span>The community </span></span><span class="ln" style="--i:1"><span>of GenAI builders </span></span><span class="ln" style="--i:2"><span>in <em class="iris-t">Europe</em></span></span></h1>
        <p class="lede fade" style="--i:2">Join the Slack, go to meetups in your city and get member discounts at our events.</p>
        <div class="cta fade" style="--i:3">
          <a class="b1" href="/join">Join the community <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="b3" href="#chapters">Find your chapter</a>
        </div>
        <p class="small fade" style="--i:4">Free. Takes two minutes, then you're in the Slack.</p>
      </div>
      <div>
        <div class="map" id="map">
          <canvas id="mapc" role="img" aria-label={madridIsForming ? 'Map of western Europe with the chapters in Valencia, Lisbon and London, and Madrid forming. Lines of light travel between the chapters.' : 'Map of western Europe with the chapters in Valencia, Lisbon, London and Madrid. Lines of light travel between the chapters.'}></canvas>
          {mapCities.map(({ slug, pos, chapter }, index) => slug === 'madrid' && madridIsForming ? (
            <a class="city" data-city="madrid" data-pos="t" style="--i:1" href={chapter ? '/chapters/madrid' : '/chapters'}>Madrid <small>forming</small></a>
          ) : chapter && (
            <a class="city" data-city={slug} data-pos={pos} style={`--i:${index}`} href={`/chapters/${slug}`}>{chapter.city} <span class="avs">{chapter.leads.map((lead) => <Image src={lead.photo} width={480} inferSize alt="" style={`object-position:${lead.photoPosition}`} />)}</span></a>
          ))}
        </div>
        <p class="legend"><span><i class="on"></i>Active chapter</span><span><i class="off"></i>Forming</span><span><i class="msg"></i>The Slack, between cities</span></p>
      </div>
    </div>
    <div style="height:clamp(40px,6vw,72px)"></div>
  </div>
</section>

<section class="band" id="join">
  <div class="wrap sec">
    <div class="jhead" data-r>
      <div class="head">
        <p class="eyebrow">Free membership</p>
        <h2 class="h2">One account. All of this is yours.</h2>
      </div>
      <div class="jact"><a class="b1" href="/join">Join the community</a><p class="small">Free. One GenAI-ID account.</p></div>
    </div>
    <div class="panels" id="how" data-r>
      <div class="pn on">
        <div class="chan" aria-hidden="true">
          <div class="rail"><b>GenAI Community</b><div># introductions</div><div class="a"># ask-the-community</div><div># jobs</div><div># events<i></i></div><div># valencia</div><div># lisbon</div><div># london</div></div>
          <div class="top"># ask-the-community <span>GenAI builders across Europe</span></div>
        </div>
        <div class="fx slk" aria-hidden="true">
          <div class="bb l" style="--i:0;--c:var(--mint);--p:#1f9d63;top:15%"><small>ML engineer · Lisbon</small>Anyone running evals on agent traces in production?</div>
          <div class="bb r" style="--i:1;--c:var(--lav);--p:#7a63e6;top:33%"><small>Data lead · Valencia</small>We do. Happy to share our setup on a call.</div>
          <div class="bb l" style="--i:2;--c:var(--rose);--p:#e0559a;top:50%"><small>Founder · London</small>Bring it to the next meetup?</div>
          <div class="typ"><i></i><i></i><i></i></div>
        </div>
        <div class="scrim"></div><span class="bar"><i></i></span>
        <div class="tx"><h3>The Slack</h3><div class="d"><div><p>Talk with GenAI builders across Europe every day. Questions, jobs, and every event announced there first.</p></div></div></div>
        <button class="hit" type="button" aria-expanded="true" aria-label="The Slack"></button>
      </div>
      <div class="pn">
        <div class="wall">
          <div class="pc ph" style="--i:0;--rot:-6deg;--tx:-33%;--ty:-12%"><Image src={imgLisbonSpeaker} width={1000} alt="A speaker pointing at a slide, next to the GenAI Community banner" /><span class="cap">Lisbon meetup</span></div>
          <div class="pc ph" style="--i:1;--rot:5deg;--tx:31%;--ty:-18%"><Image src={imgValenciaGroup} width={1000} alt="A group of people standing on a stage in front of the slide for a Valencia meetup on AI governance" style="object-position:50% 45%" /><span class="cap">Valencia meetup</span></div>
          <div class="pc po" style="--i:2;--rot:-2deg;--ty:52%" data-next-poster hidden><img alt="" loading="lazy" decoding="async"></div>
          <span class="nxt" data-next-chip hidden><i></i><span></span></span>
        </div>
        <div class="scrim"></div><span class="bar"><i></i></span>
        <div class="tx"><h3>Meetups near you</h3><div class="d"><div><p>Talks, workshops and networking run by the chapter in your city.</p></div></div></div>
        <button class="hit" type="button" aria-expanded="false" aria-label="Meetups near you"></button>
      </div>
      <div class="pn">
        <Image class="bg" src={imgWorkshopFestTables} width={1000} alt="People working on laptops at shared tables" style="object-position:55% 80%" />
        <div class="fx" aria-hidden="true">
          <div class="lan"><span class="strap"></span><span class="clip"></span><div class="bdg"><span class="k">GenAI-ID · Member</span><b>Member<br>discount</b><p>GenAI Summit EU<br>GenAI Workshop Fest</p><div class="holo"></div><span class="pct">%</span></div></div>
        </div>
        <div class="scrim"></div><span class="bar"><i></i></span>
        <div class="tx"><h3>Member discounts</h3><div class="d"><div><p>Members pay less for tickets to GenAI Summit EU and GenAI Workshop Fest.</p></div></div></div>
        <button class="hit" type="button" aria-expanded="false" aria-label="Member discounts"></button>
      </div>
    </div>
  </div>
</section>

<section id="chapters">
  <div class="wrap sec">
    <div class="row-head" data-r>
      <div class="head">
        <p class="eyebrow">Chapters</p>
        <h2 class="h2">Meet the community in your city</h2>
        <p class="dim">Each chapter runs its own meetups and workshops. Come to one, give a talk, or start a chapter where there isn't one yet.</p>
      </div>
      <a class="b3" href="/chapters">All chapters</a>
    </div>
    <div class="chs">
      {chapters.map((chapter, index) => (
        <a class="card ch" data-r style={`--i:${index}`} href={`/chapters/${chapter.slug}`}><div class="ph2">{chapter.leads.map((lead) => <Image src={lead.photo} width={480} inferSize alt={lead.name} style={`object-position:${lead.photoPosition}`} />)}</div><div class="tx"><span class={chapter.status === 'Forming' ? 'status f' : 'status'}><i></i>{chapter.status}</span><h3 class="h3">{chapter.city}</h3><p class="dim" style="font-size:15px">{chapter.country}</p></div></a>
      ))}
      {!madrid && (
        <a class="card ch" data-r style={`--i:${chapters.length}`} href="/chapters"><div class="forming" aria-hidden="true"><i></i><i></i><i></i><b></b><span>40.42° N · 3.70° W</span></div><div class="tx"><span class="status f"><i></i>Forming</span><h3 class="h3">Madrid</h3><p class="dim" style="font-size:15px">Spain</p></div></a>
      )}
    </div>
    <div class="evs" data-r>
      <UpcomingEvents label="Upcoming events" />
      <a class="b3" href="https://www.eventbrite.es/o/genai-community-121448467666?aff=ebdsshcopyurl" target="_blank" rel="noopener">All events on Eventbrite</a>
    </div>
    <div class="take">
      <a class="card spot act" data-r style="--i:0" href="https://forms.gle/uS2tiZ87TjJTAgq59" target="_blank" rel="noopener">
        <span class="ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.6-6.5-10.4a6.5 6.5 0 0 1 13 0C18.500 15.400 12 21 12 21z"/><path d="M12 8v5M9.5 10.500h5"/></svg></span>
        <span class="at"><b>Start a chapter in your city</b><span class="dim">No chapter near you? Lead one. We help with the playbook, the brand kit and your first speakers.</span></span>
        <span class="go">Apply <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
      <div class="card spot act" data-r style="--i:1">
        <span class="ico r" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.500 11a6.500 6.500 0 0 0 13 0M12 17.500V21"/></svg></span>
        <span class="at"><span class="cfp">Call for papers · <span id="days">closes 31 Jan 2027</span></span><b>Give a talk</b><span class="dim">Built something with GenAI? Share it at GenAI Summit EU 2027.</span></span>
        <a class="go" href="https://genaisummit.eu/cfp" target="_blank" rel="noopener">Submit a talk <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </div>
</section>

<section aria-label="Photos from our events">
  <div class="wrap" style="padding-bottom:16px"><p class="eyebrow">From our events</p></div>
  <div class="ribbon" id="ribbon">
    {ribbonRows.map((row, rowIndex) => (
      <div class="rrow" data-dir={rowIndex === 0 ? '-1' : '1'}>
        {row.map((tile) => 'lead' in tile ? (
          <div class="t"><Image src={tile.lead.photo} width={480} inferSize alt={tile.lead.name} style={`object-position:${tile.lead.photoPosition}`} /><span class="cap">{tile.lead.shortName} · {tile.city}</span></div>
        ) : (
          <div class={tile.wide ? 't w' : 't'}><Image src={tile.src} width={1000} alt={tile.alt} style={tile.position ? `object-position:${tile.position}` : undefined} /><span class="cap">{tile.caption}</span></div>
        ))}
      </div>
    ))}
  </div>
</section>

<section class="band" id="more">
  <div class="wrap sec">
    <div class="head" data-r>
      <p class="eyebrow">More from the community</p>
      <h2 class="h2">Events and reading</h2>
    </div>
    <div class="more">
      <a class="card mc" id="summit" data-r style="--i:0" href="https://genaisummit.eu" rel="noopener"><div class="top"><Image src={imgSummit2027Poster} width={1000} alt="GenAI Summit 2027 poster: the logo and 2027 over the City of Arts and Sciences in Valencia at night" /><span class="when"><i></i>13–14 April 2027 · Valencia</span></div><div class="tx"><h3 class="h3">GenAI Summit EU 2027</h3><p class="dim">Two days of talks, workshops and networking. The 2026 edition sold out.</p></div></a>
      <a class="card mc" data-r style="--i:1" href="https://genaiworkshopfest.com" target="_blank" rel="noopener"><div class="top"><Image src={imgWorkshopFestTables} width={1000} alt="People working on laptops at shared tables" /><span class="shade"></span><span class="lg" role="img" aria-label="GenAI Workshop Fest logo"><b>GenAI</b><span>workshop<br>fest</span></span></div><div class="tx"><h3 class="h3">GenAI Workshop Fest</h3><p class="dim">Hands-on workshops led by practitioners.</p></div></a>
      <div class="card mc off" data-r style="--i:2"><div class="top cover"><span class="when"><i></i>Coming soon</span></div><div class="tx"><h3 class="h3">The blog</h3><p class="dim">Articles on building with generative AI, written by community members.</p></div></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap writers" data-r>
    <div><h3 class="h3" style="font-size:24px">Write for the blog</h3><p class="dim" style="margin-top:6px">Writing about GenAI in production? Pitch an article.</p></div>
    <a class="b2" href="https://docs.google.com/forms/d/e/1FAIpQLScjPwZeHfBJEtiYv3nDJd6emPq6e8gh2rtjBft5ElBTxHaV4Q/viewform" target="_blank" rel="noopener">Pitch an article</a>
  </div>
</section>

<section class="band" id="newsletter">
  <div class="wrap sec">
    <div class="jhead" data-r>
      <div class="head">
        <h2 class="h2">Join the community</h2>
        <p class="dim">Free. One GenAI-ID account for the Slack, the meetups and the member discounts.</p>
      </div>
      <a class="b1" href="/join">Join the community <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>
  </div>

  <script>
(function(){
var root=document.documentElement, mq=window.matchMedia('(prefers-reduced-motion: reduce)');
var motion=!mq.matches;
function applyMotion(){root.classList.toggle('motion',motion);root.classList.toggle('motion-off',!motion);
}
applyMotion();

/* ---------- map ---------- */
var LAND={59:[[6,18]],58:[[-5,-3],[7,8],[12,16]],57:[[-6,-2],[9,10],[12,16]],56:[[-5,-3],[8,10],[12,15]],55:[[-8,-6],[-4,-2],[9,10]],54:[[-10,-6],[-3,-1],[9,19]],53:[[-9,-6],[-4,1],[5,19]],52:[[-10,-7],[-5,1],[4,19]],51:[[-4,1],[3,19]],50:[[-5,-5],[2,19]],49:[[-1,19]],48:[[-4,19]],47:[[-2,19]],46:[[-1,19]],45:[[-1,12],[14,19]],44:[[-1,7],[10,12],[16,19]],43:[[-9,6],[11,13],[17,19]],42:[[-9,3],[9,9],[12,14],[19,19]],41:[[-8,2],[9,9],[13,16],[19,19]],40:[[-8,0],[9,9],[15,18]],39:[[-9,0],[3,3],[9,9],[16,16]],38:[[-8,-1],[13,16]],37:[[-8,-2],[14,15]],36:[[-6,-5]]};
function cell(lon,lat){var r=LAND[lat];if(!r)return 0;for(var i=0;i<r.length;i++)if(lon>=r[i][0]&&lon<=r[i][1])return 1;return 0;}
function land(lon,lat){var i=Math.floor(lon),j=Math.floor(lat),fx=lon-i,fy=lat-j;
  return cell(i,j)*(1-fx)*(1-fy)+cell(i+1,j)*fx*(1-fy)+cell(i,j+1)*(1-fx)*fy+cell(i+1,j+1)*fx*fy;}
var LON0=-11.5,LATT=59.5,KX=.669,UW=31*KX,UH=24;
var CITIES=[{id:'valencia',lon:-.38,lat:39.47,on:1},{id:'lisbon',lon:-9.14,lat:38.72,on:1},{id:'london',lon:-.13,lat:51.51,on:1},{id:'madrid',lon:-3.70,lat:40.42,on:0}];
var LINKS=[[0,1,.22],[0,2,-.18],[1,2,.2],[3,0,.3]];
var COL=['#cdeede','#e8e4f7','#fbe1ef','#fdf4d6','#d6ecf6'];
var box=document.getElementById('map'),cv=document.getElementById('mapc'),ctx=cv.getContext('2d');
CITIES[3].on=box.querySelector('[data-city="madrid"] .avs')?1:0;
var W=0,H=0,u=1,dots=[],t0=performance.now(),comets=[],ripples=[],nextSpawn=2.4,ptr=null,visible=true,raf=0;
function px(c){return{x:(c.lon-LON0)*KX*u,y:(LATT-c.lat)*u};}
function layout(){
  var r=box.getBoundingClientRect();if(!r.width)return;W=r.width;H=r.height;u=W/UW;
  var d=Math.min(window.devicePixelRatio||1,2);cv.width=Math.round(W*d);cv.height=Math.round(H*d);ctx.setTransform(d,0,0,d,0,0);
  CITIES.forEach(function(c){var p=px(c);c.x=p.x;c.y=p.y;var el=box.querySelector('[data-city='+c.id+']');if(el){el.style.left=p.x+'px';el.style.top=p.y+'px';}});
  dots=[];var s=H/56,o=CITIES[0],row=0;
  for(var y=s/2;y<H;y+=s,row++)for(var x=(row%2?s/2:0)+s/2;x<W;x+=s){
    var lon=x/u/KX+LON0,lat=LATT-y/u;if(land(lon,lat)<.48)continue;
    var near=0;CITIES.forEach(function(c){if(!c.on)return;var dd=Math.hypot(x-c.x,y-c.y);near=Math.max(near,1-dd/(u*2.6));});
    dots.push({x:x,y:y,d:Math.hypot(x-o.x,y-o.y),a:.17+Math.random()*.1+Math.max(0,near)*.3});}
  LINKS.forEach(function(l){var a=CITIES[l[0]],b=CITIES[l[1]],mx=(a.x+b.x)/2,my=(a.y+b.y)/2,dx=b.x-a.x,dy=b.y-a.y;l.cx=mx-dy*l[2];l.cy=my+dx*l[2];});
  if(!motion||!visible)draw(1e3);
}
function pt(l,t){var a=CITIES[l[0]],b=CITIES[l[1]],m=1-t;return{x:m*m*a.x+2*m*t*l.cx+t*t*b.x,y:m*m*a.y+2*m*t*l.cy+t*t*b.y};}
function cl(v){return v<0?0:v>1?1:v;}
function eo(v){return 1-Math.pow(1-v,3);}
function eio(v){return v<.5?4*v*v*v:1-Math.pow(-2*v+2,3)/2;}
function back(v){var c=1.70158;return 1+(c+1)*Math.pow(v-1,3)+c*Math.pow(v-1,2);}
function draw(t){
  ctx.clearRect(0,0,W,H);
  var r=Math.max(1,u*.075),i,k;
  ctx.fillStyle='#f4f4f3';
  for(i=0;i<dots.length;i++){var d=dots[i],a=d.a*cl((t-d.d/(H*1.1))/.5);
    if(a<=0)continue;
    for(k=0;k<ripples.length;k++){var rp=ripples[k],age=t-rp.t;var w=Math.abs(Math.hypot(d.x-rp.x,d.y-rp.y)-age*u*3.2);if(w<u*.9)a+=.55*(1-w/(u*.9))*(1-age/1.5);}
    if(ptr){var pd=Math.hypot(d.x-ptr.x,d.y-ptr.y);if(pd<u*3.2)a+=.5*(1-pd/(u*3.2));}
    ctx.globalAlpha=a>1?1:a;ctx.beginPath();ctx.arc(d.x,d.y,r,0,6.2832);ctx.fill();}
  // links
  var lp=eio(cl((t-1.5)/.9));
  LINKS.forEach(function(l){if(lp<=0)return;var on=CITIES[l[0]].on&&CITIES[l[1]].on;
    ctx.globalAlpha=on?.2:.16;ctx.strokeStyle=on?'#e8e4f7':'#fdf4d6';ctx.lineWidth=1;ctx.setLineDash(on?[]:[3,5]);
    ctx.beginPath();for(var s=0;s<=28;s++){var p=pt(l,s/28*lp);s?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y);}ctx.stroke();});
  ctx.setLineDash([]);
  // comets
  if(t<900){
