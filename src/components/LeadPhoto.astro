---
import { Image, type RemoteImageProps } from 'astro:assets';

type WithPlaceholder<T> = T extends unknown ? Omit<T, 'src'> & {
  src: string | null;
  name: string | null;
} : never;
type Props = WithPlaceholder<RemoteImageProps>;

// Photo props pass through unchanged; name is only used by the placeholder.
const { name, ...imageProps } = Astro.props;
const { src, alt, class: photoClass, style } = imageProps;
const words = name?.trim().split(/\s+/).filter(Boolean) ?? [];
const initials = words.length
  ? words.slice(0, 2).map((word) => Array.from(word)[0]?.toLocaleUpperCase() ?? '').join('')
  : '·';
// Preserve the caller's scoped styles on the replacement element, too.
const scopeAttributes = Object.fromEntries(
  Object.entries(imageProps).filter(([key]) => key.startsWith('data-astro-cid-')),
);
---
{src ? <Image {...imageProps} src={src} /> : (
  <span
    {...scopeAttributes}
    class:list={[photoClass, 'lead-monogram']}
    style={style}
    role={alt === '' ? undefined : 'img'}
    aria-label={alt === '' ? undefined : name}
    aria-hidden={alt === '' ? 'true' : undefined}
  ><span>{initials}</span></span>
)}

<style is:global>
  .lead-monogram {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    container-type: size;
  }
  .lead-monogram > span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: var(--iris);
    color: var(--ink, #14131a);
    font-family: var(--display, var(--font-display));
    font-size: 40cqmin;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
</style>
